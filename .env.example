# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000

# Public origin of the app. Must be https in production.
# Browsers send this as the Origin header, so it must match the address you browse to exactly
# (localhost and 127.0.0.1 are different origins).
APP_URL=http://localhost:3000

DATABASE_URL=postgres://gatekeeper:change_me@localhost:5432/gatekeeper
# Used only by `npm test`. The database name MUST contain "test" (tests truncate tables).
TEST_DATABASE_URL=postgres://gatekeeper:change_me@localhost:5432/gatekeeper_test
# Set true when the database requires TLS (recommended for any remote database).
DATABASE_SSL=false

# Generate with: node -p "require('crypto').randomBytes(48).toString('base64url')"
# Comma-separate several secrets to rotate: newest first, older ones still verify existing cookies.
SESSION_SECRET=

# Session lifetimes
SESSION_IDLE_MINUTES=120
SESSION_REMEMBER_DAYS=14
SESSION_ABSOLUTE_DAYS=30

# Cookies (COOKIE_SECURE defaults to true when NODE_ENV=production)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Number of reverse-proxy hops in front of the app (0 = none). Required for correct
# client IPs (rate limiting) and Secure cookies behind Nginx, Render, Fly, Heroku, etc.
TRUST_PROXY=0

# Comma-separated extra browser origins allowed to call the API with credentials.
# Leave empty when the frontend is served by this app (same origin).
CORS_ORIGINS=

# Password hashing (Argon2id). Production enforces at least 19456 KiB and 2 iterations.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2

# off | optional | required
EMAIL_VERIFICATION=optional
RESET_TOKEN_MINUTES=30
VERIFY_TOKEN_HOURS=24

# console (prints emails to the terminal) | smtp. Production requires smtp.
EMAIL_TRANSPORT=console
EMAIL_FROM="Gatekeeper <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (port 465). false = STARTTLS is required (port 587).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Rate limits (per window). Windows are fixed: login 15 min, others 1 hour.
RATE_LIMIT_ENABLED=true
RL_GLOBAL_LIMIT=300
RL_LOGIN_IP_LIMIT=20
RL_LOGIN_ACCOUNT_LIMIT=10
RL_REGISTER_LIMIT=10
RL_RESET_LIMIT=5
RL_EMAIL_ACCOUNT_LIMIT=3
RL_VERIFY_LIMIT=10
