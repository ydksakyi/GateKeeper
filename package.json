{
  "name": "gatekeeper",
  "version": "1.0.0",
  "description": "Secure session-based authentication system: Express, PostgreSQL, vanilla JS frontend.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:test": "node scripts/migrate.js --test",
    "create-admin": "node scripts/create-admin.js",
    "test": "node --test --test-concurrency=1",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "nodemailer": "^10.0.11",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
